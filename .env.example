PORT=3000

JWT_SECRET=generate_strong_256_bit_secret_here
FRONTEND_URL=https://your-frontend-domain.com
API_BASE_URL=https://your-backend-domain.onrender.com

# Neon Database Configuration
DATABASE_URL=
DB_SSL=true

# ---- Mono (bank data) -------------------------------------------------------
# Server-side secret key from https://app.mono.co/apps. NEVER expose this to the
# browser; the frontend only ever needs the PUBLIC key for the Connect widget.
MONO_SECRET_KEY=

# Shared secret configured alongside the webhook URL in the Mono dashboard.
# Without it the webhook endpoint refuses every request (fails closed), because
# an open webhook lets anyone who finds the URL inject transactions.
MONO_WEBHOOK_SECRET=

# Optional. Defaults to https://api.withmono.com
MONO_BASE_URL=

# Pick ONE of the two. No domain purchase is required.
#
# A) NO DOMAIN (free, fastest). Paste the fixed inbound address your provider
#    gave you - Postmark (xxx@inbound.postmarkapp.com) or CloudMailin both hand
#    one out on signup. Each user gets a plus-addressed variant of it, and the
#    provider reports the tag back so we know whose mail it is.
EMAIL_INGEST_BASE_ADDRESS=

# B) OWN DOMAIN. Point an inbound provider at this host and set the domain that
#    receives the mail, e.g. ingest.auditace.app. Users then forward to
#    aa-<token>@<that domain>.
EMAIL_INGEST_DOMAIN=

# Local-part prefix used by option B only. Default: aa-
EMAIL_INGEST_PREFIX=
